---
import { loadContent } from "@yysng/astro-boilerplate";
import { theme } from "../config/theme.config";

const cta = await loadContent("cta");
---

<section class="py-16 text-center bg-slate-100">
  <h2 class="text-3xl font-bold">{cta.heading}</h2>

  {cta.description && (
    <p class="mt-3 text-slate-600">{cta.description}</p>
  )}

  <a
    href={cta.button.href}
    class="mt-6 inline-block rounded-lg bg-black px-6 py-3 text-white"
  >
    {cta.button.label}
  </a>
</section>
