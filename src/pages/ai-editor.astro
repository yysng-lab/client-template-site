---
export const prerender = false;

import HeroView from "../sections/HeroView.astro";
import CTASection from "../sections/CTASection.astro";
import { loadContent } from "@yysng/astro-boilerplate";

const env = Astro.locals?.runtime?.env ?? {};
const currentHero = await loadContent("hero", env);
const currentCta = await loadContent("cta", env);
---

<style>
  .page { max-width: 980px; margin: 0 auto; padding: 2rem 1rem 4rem; font-family: system-ui, -apple-system, Segoe UI, Roboto, Arial, sans-serif; }
  .top { margin-bottom: 2rem; }
  .panel { border: 1px solid #ddd; border-radius: 12px; padding: 1rem; margin-top: 1.5rem; }
  .controls { display: flex; gap: .5rem; flex-wrap: wrap; margin: .75rem 0 1rem; }
  .grid { display: flex; gap: 1rem; flex-wrap: wrap; }
  .box { flex: 1; min-width: 320px; border: 1px solid #eee; border-radius: 10px; padding: 1rem; background: #fff; }
  .field { width: 100%; max-width: 760px; }
  .muted { color: #666; font-size: .95rem; }
  button { padding: .45rem .8rem; border-radius: 10px; border: 1px solid #ddd; background: #fff; cursor: pointer; }
  button:disabled { opacity: .5; cursor: not-allowed; }
</style>

<div class="page">
  <div class="top">
    <h1>AI Editor</h1>
    <textarea id="instruction" rows="4" class="field" placeholder="Describe your change..."></textarea>
    <p id="status" class="muted"></p>
  </div>

  <!-- HERO -->
  <section class="panel">
    <h2>Hero</h2>
    <div class="controls">
      <button id="genHero">Generate</button>
      <button id="applyHero" disabled>Apply</button>
      <button id="resetHero" disabled>Reset</button>
    </div>

    <div class="grid">
      <div class="box"><HeroView data={currentHero} /></div>
      <div class="box"><div id="heroPreview"></div></div>
    </div>
  </section>

  <!-- CTA -->
  <section class="panel">
    <h2>CTA</h2>
    <div class="controls">
      <button id="genCta">Generate</button>
      <button id="applyCta" disabled>Apply</button>
      <button id="resetCta" disabled>Reset</button>
    </div>

    <div class="grid">
      <div class="box"><CTASection data={currentCta} /></div>
      <div class="box"><div id="ctaPreview"></div></div>
    </div>
  </section>

  <!-- SAFE DATA BRIDGE -->
  <script type="application/json" id="liveHeroData" set:html={JSON.stringify(currentHero)}></script>
  <script type="application/json" id="liveCtaData" set:html={JSON.stringify(currentCta)}></script>

  <script type="module">
    const status = document.getElementById("status");
    const instruction = document.getElementById("instruction");

    const genHero = document.getElementById("genHero");
    const applyHero = document.getElementById("applyHero");
    const resetHero = document.getElementById("resetHero");

    const genCta = document.getElementById("genCta");
    const applyCta = document.getElementById("applyCta");
    const resetCta = document.getElementById("resetCta");

    const heroPreview = document.getElementById("heroPreview");
    const ctaPreview = document.getElementById("ctaPreview");

    const liveHero = JSON.parse(document.getElementById("liveHeroData").textContent);
    const liveCta  = JSON.parse(document.getElementById("liveCtaData").textContent);

    let heroDraft = structuredClone(liveHero);
    let ctaDraft  = structuredClone(liveCta);

    function renderHero(d){ heroPreview.innerHTML = `<h1>${d.title||""}</h1><p>${d.subtitle||""}</p>${d.cta?`<a href="${d.cta.href}">${d.cta.label}</a>`:""}` }
    function renderCta(d){ ctaPreview.innerHTML = `<h2>${d.heading||""}</h2><p>${d.description||""}</p><a href="${d.button?.href||"#"}">${d.button?.label||""}</a>` }

    renderHero(heroDraft);
    renderCta(ctaDraft);

    async function post(url, body){
      const r = await fetch(url,{method:"POST",headers:{"Content-Type":"application/json"},body:JSON.stringify(body)});
      const j = await r.json().catch(()=>({}));
      if(!r.ok) throw new Error(j.message||j.error||"Request failed");
      return j;
    }

    // HERO
    genHero.onclick = async ()=>{
      try{
        status.textContent="Generating hero...";
        heroDraft = await post("/api/ai-generate",{section:"hero",instruction:instruction.value});
        renderHero(heroDraft);
        applyHero.disabled=false;
        resetHero.disabled=false;
        status.textContent="Hero ready";
      }catch(e){ status.textContent=e.message }
    };

    applyHero.onclick = async ()=>{
      try{
        status.textContent="Saving hero...";
        const res = await post("/api/ai-edit",{section:"hero",content:heroDraft});
        heroDraft = structuredClone(res.result);
        renderHero(heroDraft);
        status.textContent="Hero saved";
      }catch(e){ status.textContent=e.message }
    };

    resetHero.onclick = ()=>{
      heroDraft = structuredClone(liveHero);
      renderHero(heroDraft);
      status.textContent="Hero reset";
    };

    // CTA
    genCta.onclick = async ()=>{
      try{
        status.textContent="Generating CTA...";
        ctaDraft = await post("/api/ai-generate",{section:"cta",instruction:instruction.value});
        renderCta(ctaDraft);
        applyCta.disabled=false;
        resetCta.disabled=false;
        status.textContent="CTA ready";
      }catch(e){ status.textContent=e.message }
    };

    applyCta.onclick = async ()=>{
      try{
        status.textContent="Saving CTA...";
        const res = await post("/api/ai-edit",{section:"cta",content:ctaDraft});
        ctaDraft = structuredClone(res.result);
        renderCta(ctaDraft);
        status.textContent="CTA saved";
      }catch(e){ status.textContent=e.message }
    };

    resetCta.onclick = ()=>{
      ctaDraft = structuredClone(liveCta);
      renderCta(ctaDraft);
      status.textContent="CTA reset";
    };
  </script>
</div>