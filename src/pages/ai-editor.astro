---
export const prerender = false;

import HeroView from "../sections/HeroView.astro";
import CTASection from "../sections/CTASection.astro";
import { loadContent } from "@yysng/astro-boilerplate";

const env = Astro.locals?.runtime?.env ?? {};
const currentHero = await loadContent("hero", env);
const currentCta = await loadContent("cta", env);
---
<style>
  .page {
    max-width: 980px;
    margin: 0 auto;
    padding: 2rem 1rem 4rem;
    font-family: system-ui, -apple-system, Segoe UI, Roboto, Arial, sans-serif;
  }
  .top { margin-bottom: 2rem; }
  .panel {
    border: 1px solid #ddd;
    border-radius: 12px;
    padding: 1rem;
    margin-top: 1.5rem;
  }
  .controls { display: flex; gap: 0.5rem; flex-wrap: wrap; margin: 0.75rem 0 1rem; }
  .grid { display: flex; gap: 1rem; flex-wrap: wrap; }
  .box {
    flex: 1; min-width: 320px; border: 1px solid #eee;
    border-radius: 10px; padding: 1rem; background: #fff;
  }
  .field { width: 100%; max-width: 760px; }
  .muted { color: #666; font-size: 0.95rem; }
  button {
    padding: 0.45rem 0.8rem; border-radius: 10px;
    border: 1px solid #ddd; background: #fff; cursor: pointer;
  }
  button:disabled { opacity: 0.5; cursor: not-allowed; }
  hr { margin: 1.25rem 0; border: none; border-top: 1px solid #eee; }
</style>

<div class="page">
  <div class="top">
    <h1>AI Editor</h1>
    <textarea id="instruction" rows="4" class="field" placeholder="Describe your change..."></textarea>
    <p id="status" class="muted"></p>
  </div>

  <!-- HERO -->
  <section class="panel">
    <h2>Hero</h2>
    <div class="controls">
      <button id="genHero">Generate</button>
      <button id="saveHero" disabled>Apply</button>
    </div>

    <div class="grid">
      <div class="box"><HeroView data={currentHero} /></div>
      <div class="box"><div id="heroPreview"></div></div>
    </div>
  </section>

  <!-- CTA -->
  <section class="panel">
    <h2>CTA</h2>
    <div class="controls">
      <button id="genCta">Generate</button>
      <button id="saveCta" disabled>Apply</button>
    </div>

    <div class="grid">
      <div class="box"><CTASection data={currentCta} /></div>
      <div class="box"><div id="ctaPreview"></div></div>
    </div>
  </section>

  <script type="module">
    const status = document.getElementById("status");

    async function post(url, body) {
      const r = await fetch(url, { method: "POST", headers: { "Content-Type": "application/json" }, body: JSON.stringify(body) });
      const j = await r.json().catch(() => ({}));
      if (!r.ok) throw new Error(j.message || j.error || "Request failed");
      return j;
    }

    let heroDraft = null;
    let ctaDraft = null;

    const heroPreview = document.getElementById("heroPreview");
    const ctaPreview = document.getElementById("ctaPreview");

    function renderHero(d) {
      heroPreview.innerHTML = `<h1>${d.title||""}</h1><p>${d.subtitle||""}</p>${d.cta?`<a href="${d.cta.href}">${d.cta.label}</a>`:""}`;
    }
    function renderCta(d) {
      ctaPreview.innerHTML = `<h2>${d.heading||""}</h2><p>${d.description||""}</p><a href="${d.button?.href||"#"}">${d.button?.label||""}</a>`;
    }

    document.getElementById("genHero").onclick = async () => {
      try {
        status.textContent = "Generating hero...";
        heroDraft = await post("/api/ai-generate", { section: "hero", instruction: instruction.value });
        renderHero(heroDraft);
        saveHero.disabled = false;
        status.textContent = "Hero ready";
      } catch(e){ status.textContent = e.message }
    };

    document.getElementById("saveHero").onclick = async () => {
      try {
        status.textContent = "Saving hero...";
        await post("/api/ai-edit", { section: "hero", content: heroDraft });
        location.reload();
      } catch(e){ status.textContent = e.message }
    };

    document.getElementById("genCta").onclick = async () => {
      try {
        status.textContent = "Generating CTA...";
        ctaDraft = await post("/api/ai-generate", { section: "cta", instruction: instruction.value });
        renderCta(ctaDraft);
        saveCta.disabled = false;
        status.textContent = "CTA ready";
      } catch(e){ status.textContent = e.message }
    };

    document.getElementById("saveCta").onclick = async () => {
      try {
        status.textContent = "Saving CTA...";
        await post("/api/ai-edit", { section: "cta", content: ctaDraft });
        location.reload();
      } catch(e){ status.textContent = e.message }
    };
  </script>
</div>